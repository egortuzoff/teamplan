# Образец настроек TeamPlan. Настоящие значения в репозиторий не попадают.
#
# Демонстрационный режим (локальный запуск по README) работает без файла .env:
# у всех переменных есть значения по умолчанию в docker-compose.yml.
# Рабочий режим: скопируйте файл в .env на сервере (cp .env.example .env)
# и замените значения. Файл .env указан в .gitignore.

# ---------- PostgreSQL (контейнер db) ----------
# Имя базы и пользователь. По умолчанию teamplan.
POSTGRES_DB=teamplan
POSTGRES_USER=teamplan
# Пароль пользователя базы. В рабочем режиме — длинный случайный пароль,
# например из команды: openssl rand -hex 24
# (только буквы и цифры: пароль входит в DATABASE_URL, спецсимволы пришлось бы
# кодировать). По умолчанию teamplan-demo — только для демонстрационного режима.
# Пароль применяется при первом создании тома базы; чтобы сменить его позже,
# смените пароль и в самой базе (ALTER USER).
POSTGRES_PASSWORD=замените-на-случайный-пароль

# Порт базы на этом компьютере (127.0.0.1) для запуска без Docker и тестов.
# По умолчанию 5432; задайте другой, если 5432 занят.
DB_PORT=5432

# ---------- Приложение ----------
# ТР-7: адрес базы одной строкой. Обычно не задаётся: docker-compose.yml
# собирает его из переменных POSTGRES_* выше (сервер db внутри Docker).
# Задайте, чтобы подключить приложение к другой базе, например к управляемой
# СУБД (РЗ-8):
# DATABASE_URL=postgresql://пользователь:пароль@адрес:5432/имя-базы

# Часовой пояс команды. По умолчанию Europe/Moscow.
TZ=Europe/Moscow

# ---------- Тесты (только на компьютере разработчика) ----------
# Отдельная база для автотестов: тесты удаляют из неё все данные.
# Переменная задаётся в терминале перед запуском pytest, см. README.
# TEST_DATABASE_URL=postgresql://teamplan:teamplan-demo@localhost:5432/teamplan_test
